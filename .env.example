# Copy to .env only for local, non-production settings.
POSTGRES_DB=crisisgrid
POSTGRES_USER=crisisgrid_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://crisisgrid_app:change-this-local-password@localhost:5432/crisisgrid
# Optional for a verified hosted PostgreSQL connection (for example Supabase).
# Keep the downloaded CA certificate outside this repository.
# DATABASE_SSL_CA_FILE=C:\\Users\\your-name\\Downloads\\prod-supabase.crt
JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_EXPIRES_IN=8h

# Optional future live-service configuration. Keep real values only in .env,
# never in source control or the browser's developer console.
# VITE_MAPBOX_PUBLIC_TOKEN=pk.your-restricted-browser-token
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

